#!/bin/sh
# ==============================================================================
# xkeen-happ-setup — доустановка XKeen Happ на роутере с уже работающим Entware.
# Вызывается установщиком по SSH (install-xkeen-sub.sh) и при первом старте с
# флешки (S98xkeen-happ-bootstrap). Повторный запуск безопасен.
#
#   xkeen-happ-setup [--sub URL|КЛЮЧИ] [--mode blocked|except_ru|full]
#                    [--select auto|manual] [--skip-xkeen] [--no-dns] [--no-policy]
#
# Код выхода 0 — всё установлено и панель запущена.
# ==============================================================================

export PATH="/opt/sbin:/opt/bin:/usr/sbin:/usr/bin:/sbin:/bin"

OPT_DIR="${XKEEN_OPT_DIR:-/opt}"
HAPP_DIR="$OPT_DIR/etc/xkeen-happ"
CONFIG_FILE="$HAPP_DIR/config.json"
XKEEN_URL="https://github.com/jameszeroX/XKeen/releases/latest/download/xkeen.tar.gz"
PACKAGES="curl jq ca-bundle lighttpd lighttpd-mod-cgi lighttpd-mod-setenv"
# Стартовый пакет с флешки: пакеты Entware, XKeen, Xray и геобазы уже внутри
# (там, где репозиторий Entware или GitHub без VPN недоступны)
OFFLINE_DIR="$OPT_DIR/var/xkeen-happ-offline"

SUB_INPUT=""
ROUTING_MODE=""
SELECTION_MODE=""
SKIP_XKEEN="0"
RCI_ARGS=""

while [ $# -gt 0 ]; do
    case "$1" in
        --sub|-s)     SUB_INPUT="$2"; shift 2 ;;
        --mode|-m)    ROUTING_MODE="$2"; shift 2 ;;
        --select)     SELECTION_MODE="$2"; shift 2 ;;
        --skip-xkeen) SKIP_XKEEN="1"; shift ;;
        --no-dns)     RCI_ARGS="$RCI_ARGS --no-dns"; shift ;;
        --no-policy)  RCI_ARGS="$RCI_ARGS --no-policy"; shift ;;
        *)            echo "Неизвестный параметр: $1" >&2; exit 2 ;;
    esac
done

step() { printf '\n\033[1;36m[%s]\033[0m %s\n' "$1" "$2"; }
die()  { printf '\033[1;31mОшибка:\033[0m %s\n' "$1" >&2; exit 1; }

# Один запуск за раз (флешка при загрузке + ручной запуск по SSH)
exec 8>/tmp/xkeen-happ-setup.lock
if command -v flock >/dev/null 2>&1; then
    flock -n 8 || die "установка уже идёт в другом процессе"
fi

[ -d "$OPT_DIR" ] && command -v opkg >/dev/null 2>&1 || die "Entware не найден (нет /opt или opkg)"

# --- 1. Сеть ----------------------------------------------------------------
step 1/6 "Проверка доступа в интернет..."
i=0
until curl -s -o /dev/null -m 8 http://bin.entware.net/ || curl -s -o /dev/null -m 8 http://github.com/ \
    || curl -s -o /dev/null -m 8 https://ya.ru/; do
    i=$((i + 1))
    [ "$i" -ge 18 ] && die "нет доступа в интернет (ждали 3 минуты)"
    sleep 10
done

# --- 2. Пакеты Entware ---------------------------------------------------------
step 2/6 "Установка пакетов Entware: $PACKAGES"
opkg update >/dev/null 2>&1 || echo "  opkg update завершился с ошибкой, пробуем установить из кэша"
# shellcheck disable=SC2086
opkg install $PACKAGES || echo "  часть пакетов не установилась — проверяем, чего не хватает"
for bin in curl jq lighttpd; do
    command -v "$bin" >/dev/null 2>&1 || die "не установлен $bin (opkg install $PACKAGES)"
done
[ -s "$OPT_DIR/etc/ssl/certs/ca-certificates.crt" ] || die "не установлен ca-bundle — без него нельзя проверить сертификаты"
# Пакет lighttpd ставит свой автозапуск (S80lighttpd) — второй веб-сервер не нужен
[ -f "$OPT_DIR/etc/init.d/S80lighttpd" ] && sed -i 's/^ENABLED=yes/ENABLED=no/' "$OPT_DIR/etc/init.d/S80lighttpd"

# --- 3. Настройка роутера (политика XKeen, DNS, автозапуск Entware) -------------------
step 3/6 "Настройка роутера через NDMS (политика XKeen, DNS, автозапуск)..."
missing=$("$OPT_DIR/bin/xkeen-rci-setup" components 2>/dev/null)
case "$missing" in
    ""|unknown) ;;
    *)
        printf '\n  Не хватает компонентов прошивки: \033[1;33m%s\033[0m\n' "$missing"
        echo "  Веб-интерфейс роутера → «Общие настройки» → «Изменить набор компонентов»:"
        case "$missing" in *opkg-kmod-netfilter-addons*) echo "    • Пакет расширения Xtables-addons для Netfilter" ;; esac
        case " $missing " in *" opkg-kmod-netfilter "*) echo "    • Модули ядра подсистемы Netfilter" ;; esac
        case " $missing " in *" opkg "*) echo "    • Поддержка открытых пакетов" ;; esac
        echo "  Установите их (роутер перезагрузится) и запустите установку ещё раз."
        die "нет нужных компонентов прошивки"
        ;;
esac
# shellcheck disable=SC2086
"$OPT_DIR/bin/xkeen-rci-setup" setup $RCI_ARGS || echo "  RCI недоступен — пропускаем (политику можно создать вручную)"

# --- 4. XKeen + Xray + геобазы -------------------------------------------------------
if [ "$SKIP_XKEEN" = "1" ]; then
    step 4/6 "Установка XKeen пропущена (--skip-xkeen)"
elif [ -x "$OPT_DIR/sbin/xkeen" ] && [ -x "$OPT_DIR/sbin/xray" ]; then
    step 4/6 "XKeen и Xray уже установлены"
elif [ -f "$OFFLINE_DIR/xkeen.tar.gz" ]; then
    step 4/6 "Установка XKeen из стартового пакета ($(cat "$OFFLINE_DIR/VERSIONS" 2>/dev/null | tr '\n' ' '))..."
    tar -xzf "$OFFLINE_DIR/xkeen.tar.gz" -C "$OPT_DIR/sbin/" || die "архив XKeen повреждён"
    chmod +x "$OPT_DIR/sbin/xkeen"
    # Ядро: на роутерах без FPU XKeen берёт сборку softfloat — та же проверка, что у него
    xray_bin="$OFFLINE_DIR/xray/xray"
    if [ -f "$OFFLINE_DIR/xray/xray_softfloat" ]; then
        case "$(curl -s -m 5 http://127.0.0.1:79/rci/show/version)" in
            *KN-1212*|*KN-2310*|*KN-2311*|*KN-2910*) xray_bin="$OFFLINE_DIR/xray/xray_softfloat" ;;
        esac
    fi
    cp "$xray_bin" "$OPT_DIR/sbin/xray" && chmod 755 "$OPT_DIR/sbin/xray" || die "не удалось установить Xray"
    # Геобазы и списки GeoIPSET под теми именами, что дал бы XKeen; обновлять их будет его cron
    mkdir -p "$OPT_DIR/etc/xray/dat" "$OPT_DIR/etc/xkeen/ipset"
    cp "$OFFLINE_DIR"/geo/*.dat "$OPT_DIR/etc/xray/dat/"
    ln -sf "$OPT_DIR/etc/xray/dat/geosite_zkeen.dat" "$OPT_DIR/etc/xray/dat/zkeen.dat"
    ln -sf "$OPT_DIR/etc/xray/dat/geoip_zkeenip.dat" "$OPT_DIR/etc/xray/dat/zkeenip.dat"
    cp "$OFFLINE_DIR/ipset/ru_exclude_ipv4.lst" "$OFFLINE_DIR/ipset/ru_exclude_ipv6.lst" "$OPT_DIR/etc/xkeen/ipset/"
    # cores=none, geo=off, geoipset=off: XKeen ничего не качает и берёт уже разложенное.
    # _gh_probed: проверку GitHub пропускаем — он для этой установки не нужен.
    _gh_probed=1 "$OPT_DIR/sbin/xkeen" -i auto cores=none geo=off geoipset=off cron=on autostart=on </dev/null \
        || die "XKeen не установился — подробности выше"
    [ -x "$OPT_DIR/sbin/xray" ] || die "после установки XKeen нет ядра Xray"
else
    step 4/6 "Установка XKeen (Xray, геобазы zkeen/v2fly, GeoIPSET, автозапуск)..."
    tmp="/opt/tmp/xkeen.tar.gz"
    mkdir -p /opt/tmp
    curl -fsSL --retry 3 -m 120 "$XKEEN_URL" -o "$tmp" || die "не удалось скачать XKeen с GitHub"
    tar -xzf "$tmp" -C "$OPT_DIR/sbin/" || die "архив XKeen повреждён"
    rm -f "$tmp"
    chmod +x "$OPT_DIR/sbin/xkeen"
    # «-i auto» — штатная автоустановка XKeen без вопросов
    "$OPT_DIR/sbin/xkeen" -i auto cores=xray geo=on geoipset=on cron=on autostart=on </dev/null \
        || die "XKeen не установился — подробности выше"
    [ -x "$OPT_DIR/sbin/xray" ] || die "после установки XKeen нет ядра Xray"
fi

# --- 5. Подписка ------------------------------------------------------------------
step 5/6 "Настройка подписки..."
"$OPT_DIR/bin/xkeen-sub" status >/dev/null 2>&1
patch="{}"
# Подписка, вшитая в архив флешки при сборке (build-release.sh --sub)
if [ -z "$SUB_INPUT" ] && [ -f "$HAPP_DIR/preset.json" ]; then
    SUB_INPUT=$(jq -r '.sub_url // empty' "$HAPP_DIR/preset.json")
    rm -f "$HAPP_DIR/preset.json"
fi
if [ -n "$SUB_INPUT" ]; then
    case "$SUB_INPUT" in
        http://*|https://*) patch=$(jq -n --arg u "$SUB_INPUT" '{sub_url: $u}') ;;
        *)                  patch=$(jq -n --arg l "$SUB_INPUT" '{manual_links: $l}') ;;
    esac
fi
[ -n "$ROUTING_MODE" ] && patch=$(printf '%s' "$patch" | jq --arg m "$ROUTING_MODE" '. + {routing_mode: $m}')
[ -n "$SELECTION_MODE" ] && patch=$(printf '%s' "$patch" | jq --arg s "$SELECTION_MODE" '. + {selection_mode: $s}')

printf '%s' "$patch" | "$OPT_DIR/bin/xkeen-sub" save-config
rc=$?
[ "$rc" -ge 2 ] && die "неверные параметры подписки"

has_source=$(jq -r 'if (.sub_url // "") != "" or (.manual_links // "") != "" then "1" else "" end' "$CONFIG_FILE")
if [ -n "$has_source" ]; then
    if "$OPT_DIR/bin/xkeen-sub" update; then
        echo "  Подписка загружена: $(jq -r '.profile_title' "$HAPP_DIR/state.json") ($(jq -r '.server_count' "$HAPP_DIR/state.json") серв.)"
        # По умолчанию — выбор сервера по реальной скорости (XKeen 2.1+), если серверов несколько
        if [ -z "$SELECTION_MODE" ] && [ "$(jq -r '.server_count' "$HAPP_DIR/state.json")" -ge 2 ] 2>/dev/null \
            && [ "$("$OPT_DIR/bin/xkeen-happ-ctl" speed-state)" = "off" ]; then
            echo "  Включаю выбор сервера по реальной скорости (замер займёт около минуты)..."
            "$OPT_DIR/bin/xkeen-happ-ctl" speed on >/dev/null 2>&1 || echo "  Не получилось — включите в панели: Серверы → «Самый быстрый»"
        fi
    else
        echo "  Подписку загрузить не удалось: $(jq -r '.last_error' "$HAPP_DIR/state.json") — её можно вставить в панели"
    fi
else
    "$OPT_DIR/bin/xkeen-sub" cron >/dev/null 2>&1
    echo "  Подписка не указана — вставьте её в веб-панели"
fi
# Планировщик: XKeen ставит свой crond (S05crond). Второй демон (пакет cron) выполнял бы
# задачи дважды, поэтому cron ставим, только если планировщика нет совсем.
if ! ls "$OPT_DIR"/etc/init.d/S*cron* >/dev/null 2>&1; then
    opkg install cron >/dev/null 2>&1 || echo "  не удалось установить cron — автообновление не будет работать"
fi
for s in "$OPT_DIR"/etc/init.d/S*cron*; do
    [ -x "$s" ] && { pidof crond >/dev/null 2>&1 || pidof cron >/dev/null 2>&1 || "$s" start >/dev/null 2>&1; }
done

# --- 6. Веб-панель ------------------------------------------------------------------
step 6/6 "Запуск веб-панели..."
"$OPT_DIR/etc/init.d/S99xkeen-happ" restart || die "панель не запустилась"

date '+%F %T' > "$HAPP_DIR/.installed"

# Стартовый пакет больше не нужен: возвращаем сетевые репозитории Entware и освобождаем место
if [ -d "$OFFLINE_DIR" ]; then
    [ -f "$OFFLINE_DIR/opkg.conf.online" ] && cp "$OFFLINE_DIR/opkg.conf.online" "$OPT_DIR/etc/opkg.conf"
    rm -rf "$OFFLINE_DIR"
fi

ROUTER_IP="$(ip -4 addr show br0 2>/dev/null | awk '/inet / {split($2, a, "/"); print a[1]; exit}')"
printf '\n\033[1;32mГотово.\033[0m Панель: \033[1;36mhttp://%s:8099\033[0m — при первом входе задайте пароль.\n' "${ROUTER_IP:-192.168.1.1}"
exit 0
